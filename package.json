{
  "name": "buildnow-companion",
  "version": "2.0.0",
  "private": true,
  "description": "BuildNow Companion — Photon WebSocket capture, decrypt & Discord Rich Presence",
  "scripts": {
    "dev": "concurrently \"node app/dev.js\" \"node companion/decryptor.js\"",
    "server": "node app/dev.js",
    "decryptor": "node companion/decryptor.js",
    "discord": "node discord-bridge.js",
    "decode": "node decode.js",
    "debug": "node debug-collector.js",
    "build": "node tools/bundle.js",
    "obfs": "node scripts/obfuscate.mjs",
    "lite": "node scripts/build-lite.js",
    "competitive": "node scripts/build-lite.js && node scripts/build-competitive.js",
    "test": "node test/debug-collector.test.mjs && node test/decoder.test.mjs && node test/detector.test.mjs && node test/sender.test.mjs && node test/bundle.test.mjs"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "discord-rpc": "^4.0.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "dotenv": "^17.4.2",
    "javascript-obfuscator": "^5.8.0"
  }
}
